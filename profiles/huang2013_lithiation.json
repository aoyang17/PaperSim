      ],
      "id": "spherical_strain_rates",
      "latex": "\\dot{\\varepsilon}_r=\\dot{\\varepsilon}^{c}_r+\\dot{\\varepsilon}^{e}_r+\\dot{\\varepsilon}^{p}_r,\\qquad \\dot{\\varepsilon}_\\theta=\\dot{\\varepsilon}_\\phi=\\dot{\\varepsilon}^{c}_\\theta+\\dot{\\varepsilon}^{e}_\\theta+\\dot{\\varepsilon}^{p}_\\theta",
      "number": 6,
      "referenced_symbols": [
        "\\varepsilon^{c}_r",
        "\\varepsilon^{e}_r",
        "\\varepsilon^{p}_r",
