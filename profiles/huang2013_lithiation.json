      "parameter": "case_id",
      "study": "param",
      "tlist": "range(0,0.005,tfinal)",
      "values": "range(1,1,3)"
    },
    "tree_changes": [
      "Component 1 -> Geometry g1 -> Interval [0,1]",
      "Component 1 -> Definitions -> Variables v_case, v_aux, v_constitutive",
      "Component 1 -> Physics -> four Weak Form PDE interfaces for control equations",
      "Study std1 -> Parametric Sweep case_id over 1..3, then Transient",
      "One unsolved MPH contains all parameter combinations"
    ],
    "variable_groups": [
      {
        "tag": "v_case",
        "variables": [
          {
            "description": "case-selected logistic sharpness",
            "expression": "if(case_id==1,B_single_phase,B_two_phase)",
            "name": "B_case",
            "units": "1"
          },
          {
            "description": "case-selected radial chemical expansion coefficient",
            "expression": "if(case_id==3,1,beta_r)",
            "name": "betaR_case",
            "units": "1"
          },
          {
            "description": "case-selected hoop chemical expansion coefficient",
            "expression": "if(case_id==3,0,beta_theta)",
            "name": "betaT_case",
            "units": "1"
          }
        ]
      },
      {
        "tag": "v_aux",
        "variables": [
          {
            "description": "initial phase-boundary position",
            "expression": "1+8/B_case",
            "name": "rc0_case",
            "units": "1"
          },
          {
            "description": "final phase-boundary position",
            "expression": "-8/B_case",
            "name": "rc1_case",
            "units": "1"
          },
          {
            "description": "moving logistic concentration front",
            "expression": "rc0_case+(rc1_case-rc0_case)*min(t/tfinal,1)",
            "name": "front",
            "units": "1"
          },
          {
            "description": "smooth numerical startup factor",
            "expression": "t^2/(t^2+tramp^2)",
            "name": "startup",
            "units": "1"
          },
          {
            "description": "normalized Li concentration profile",
            "expression": "startup/(1+exp(-B_case*(x-front)))",
            "name": "c",
            "units": "1"
          }
        ]
      },
      {
        "tag": "v_constitutive",
        "variables": [
          {
            "description": "radial chemical strain from Eq. (7)",
            "expression": "betaR_case*c",
            "name": "ecr",
            "units": "1"
          },
          {
            "description": "hoop chemical strain from Eq. (7)",
            "expression": "betaT_case*c",
            "name": "ect",
            "units": "1"
          },
          {
            "description": "radial elastic strain from Eq. (1)",
            "expression": "ux-ecr-u2",
            "name": "er",
            "units": "1"
          },
          {
            "description": "hoop elastic strain from Eq. (6) with axis regularization",
            "expression": "if(x>xfloor,u/x-ect-u3,ux-ect-u3)",
            "name": "et",
            "units": "1"
          },
          {
            "description": "isotropic elasticity prefactor from Eq. (8)",
            "expression": "1/((1+nu)*(1-2*nu))",
            "name": "coef",
            "units": "1"
          },
          {
            "description": "radial stress normalized by E from Eq. (8)",
            "expression": "coef*((1-nu)*er+2*nu*et)",
            "name": "sigr_over_E",
            "units": "1"
          },
          {
            "description": "hoop stress normalized by E from Eq. (8)",
            "expression": "coef*(et+nu*er)",
            "name": "sigt_over_E",
            "units": "1"
          },
          {
            "description": "spherical effective stress from Eq. (11)",
            "expression": "abs(sigr_over_E-sigt_over_E)",
            "name": "mises_over_E",
            "units": "1"
          },
          {
            "description": "regularized effective stress used in Eq. (12)",
            "expression": "max(abs(sigr_over_E-sigt_over_E),sefloor)",
            "name": "se_over_E",
            "units": "1"
          },
          {
            "description": "radial J2 flow direction from Eqs. (9)-(10)",
            "expression": "(sigr_over_E-sigt_over_E)/se_over_E",
            "name": "flow",
            "units": "1"
          },
          {
            "description": "effective plastic strain rate from Eq. (12)",
            "expression": "epdot0*(se_over_E/sigma_Y_over_E)^(1/mvis)",
            "name": "pdot",
            "units": "1/s"
          },
          {
            "description": "radial plastic strain rate from Eq. (9)",
            "expression": "pdot*flow",
            "name": "epr_rate",
            "units": "1/s"
          },
          {
            "description": "hoop plastic strain rate from Eq. (9)",
            "expression": "-0.5*pdot*flow",
            "name": "ept_rate",
            "units": "1/s"
          }
        ]
      }
    ]
  },
