      ],
      "id": "hooke_rate",
      "latex": "\\dot{\\varepsilon}^{e}_{ij}=\\frac{1}{E}\\left[(1+\\nu)\\dot{\\sigma}_{ij}-\\nu\\dot{\\sigma}_{kk}\\delta_{ij}\\right]",
