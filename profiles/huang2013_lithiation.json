        "\\sigma_\\theta"
      ],
      "id": "hooke_spherical",
      "latex": "\\dot{\\sigma}_r=\\frac{E}{(1+\\nu)(1-2\\nu)}\\left[(1-\\nu)\\dot{\\varepsilon}^{e}_r+2\\nu\\dot{\\varepsilon}^{e}_\\theta\\right],\\qquad \\dot{\\sigma}_\\theta=\\frac{E}{(1+\\nu)(1-2\\nu)}\\left[\\dot{\\varepsilon}^{e}_\\theta+\\nu\\dot{\\varepsilon}^{e}_r\\right]",
      "number": 8,
      "referenced_symbols": [
