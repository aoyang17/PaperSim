      ],
      "id": "plastic_flow_spherical",
      "latex": "\\dot{\\varepsilon}^{p}_r=\\dot{\\varepsilon}^{p}\\frac{3s_r}{2\\sigma_e},\\qquad \\dot{\\varepsilon}^{p}_\\theta=\\dot{\\varepsilon}^{p}_\\phi=\\dot{\\varepsilon}^{p}\\frac{3s_\\theta}{2\\sigma_e}",
