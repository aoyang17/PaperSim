    {
      "classification": "constitutive",
      "dependent_variables": [
        "\\varepsilon^{c}_r",
        "\\varepsilon^{c}_\\theta"
      ],
      "id": "spherical_chemical_strain",
      "latex": "\\dot{\\varepsilon}^{c}_r=\\beta_r\\dot{c},\\qquad \\dot{\\varepsilon}^{c}_\\theta=\\dot{\\varepsilon}^{c}_\\phi=\\beta_\\theta\\dot{c}",
      "number": 7,
      "referenced_symbols": [
