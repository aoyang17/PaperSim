      ],
      "id": "total_strain_decomposition",
      "latex": "\\dot{\\varepsilon}_{ij}=\\dot{\\varepsilon}^{c}_{ij}+\\dot{\\varepsilon}^{e}_{ij}+\\dot{\\varepsilon}^{p}_{ij}",
      "number": 1,
      "referenced_symbols": [
