      "latex": "\\mathbf{E}^{e}=\\frac{1}{2}[(\\mathbf{F}^{e})^{T}\\mathbf{F}^{e}-\\mathbf{I}],\\quad \\mathbf{E}^{c}=\\frac{1}{2}[(\\mathbf{F}^{c})^{T}\\mathbf{F}^{c}-\\mathbf{I}],\\quad \\mathbf{E}^{p}=\\frac{1}{2}[(\\mathbf{F}^{p})^{T}\\mathbf{F}^{p}-\\mathbf{I}]",
