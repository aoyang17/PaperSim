# Example-only environment file. Copy it outside the repository and edit locally.
YEESUAN_CONFIG=~/.config/papersim/yeesuan_comsol.json
YEESUAN_PASSWORD_FILE=~/.config/papersim/yeesuan_password
YEESUAN_IDENTITY_FILE=~/.ssh/remote_comsol_ed25519
# Python with PaperSim, pydantic, and pexpect installed:
YEESUAN_PYTHON=/path/to/venv/bin/python
PAPERSIM_SRC=/path/to/PaperSim/src
